<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The groupId is declared once, here, and inherited by every module (decision 86). Artifact names do not contain the product name. -->
  <groupId>ai.generativearchitects.slay400</groupId>
  <artifactId>gateway-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>gateway-parent</name>
  <description>The slay400 gateway, Community Edition: serves the APIs of a bundle over HTTP.</description>
  <url>https://github.com/generativearchitects-ai/slay400</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>Generative Architects</name>
    <url>https://generativearchitects.ai</url>
  </organization>

  <licenses>
    <license>
      <name>Business Source License 1.1</name>
      <url>https://github.com/generativearchitects-ai/slay400/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/generativearchitects-ai/slay400.git</connection>
    <developerConnection>scm:git:https://github.com/generativearchitects-ai/slay400.git</developerConnection>
    <url>https://github.com/generativearchitects-ai/slay400</url>
  </scm>

  <modules>
    <module>gateway-runtime</module>
    <!-- <module>gateway-server</module> -->
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- slay400-core, through its bill of materials (decision 98). Until the first release the snapshot is used. -->
    <slay400-core.version>0.1.0-SNAPSHOT</slay400-core.version>
    <!-- The YAML library slay400-core uses; no second one (kickoff 02). -->
    <snakeyaml-engine.version>3.2</snakeyaml-engine.version>
    <!-- Helidon 4 line, Helidon SE (decisions 93 and 97; the patch release is decision 1 of the pull request). -->
    <helidon.version>4.5.7</helidon.version>

    <!-- The same test and mutation tooling as slay400-core. -->
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <pitest.version>1.30.2</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <pitest.threads>4</pitest.threads>
    <!-- Mutation threshold of gateway-runtime, in percent (kickoff 02). -->
    <mutation.threshold>90</mutation.threshold>
  </properties>

  <!-- slay400-core publishes a snapshot from main to the Maven Central snapshot repository (decisions 92 and 98). -->
  <repositories>
    <repository>
      <id>central-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ai.generativearchitects.slay400</groupId>
        <artifactId>pcml-bom</artifactId>
        <version>${slay400-core.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${snakeyaml-engine.version}</version>
      </dependency>
      <dependency>
        <groupId>io.helidon.webserver</groupId>
        <artifactId>helidon-webserver</artifactId>
        <version>${helidon.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.3</version>
        </plugin>
        <plugin>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Mutation analysis (kickoff 02): PIT changes the production code of gateway-runtime and the tests must notice. CI runs it. -->
    <profile>
      <id>mutation</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-maven</artifactId>
              <version>${pitest.version}</version>
              <dependencies>
                <dependency>
                  <groupId>org.pitest</groupId>
                  <artifactId>pitest-junit5-plugin</artifactId>
                  <version>${pitest-junit5.version}</version>
                </dependency>
              </dependencies>
              <configuration>
                <targetClasses>
                  <param>ai.generativearchitects.slay400.gateway.*</param>
                </targetClasses>
                <mutationThreshold>${mutation.threshold}</mutationThreshold>
                <threads>${pitest.threads}</threads>
                <outputFormats>
                  <outputFormat>HTML</outputFormat>
                  <outputFormat>XML</outputFormat>
                </outputFormats>
                <timestampedReports>false</timestampedReports>
              </configuration>
              <executions>
                <execution>
                  <id>mutation-coverage</id>
                  <phase>verify</phase>
                  <goals>
                    <goal>mutationCoverage</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
