<pcml version="7.0">
   <!-- Expected PCML (kickoff 05): written from the compiler's output for the same kinds of fields in run 1, checked by the strict comparison of the next run and then replaced by the compiler's own output. -->
   <program name="TSTUSAMID" path="/QSYS.LIB/OWNERLIB.LIB/TSTUSAMID.PGM">
      <data name="ISOMID" type="time" timeformat="ISO" timeseparator="period" usage="input" />
      <data name="USA12" type="time" timeformat="USA" timeseparator="colon" usage="input" />
      <data name="USA00" type="time" timeformat="USA" timeseparator="colon" usage="input" />
      <data name="USAFROMISO" type="time" timeformat="USA" timeseparator="colon" usage="inputoutput" />
      <data name="ISOFROM12" type="time" timeformat="ISO" timeseparator="period" usage="inputoutput" />
      <data name="ISOFROM00" type="time" timeformat="ISO" timeseparator="period" usage="inputoutput" />
   </program>
</pcml>
