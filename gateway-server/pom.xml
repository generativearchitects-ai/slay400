<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.generativearchitects.slay400</groupId>
    <artifactId>gateway-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gateway-server</artifactId>
  <name>gateway-server</name>
  <description>The Helidon adapter around gateway-runtime, main, and the runnable distribution.</description>

  <dependencies>
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>gateway-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- At run time only: the server never names a class of the ibmi backend. In the distribution the backend sits in
         lib/ibmi and is loaded, with the JTOpen the operator supplies, by a class loader of its own (gateway kickoff 10). -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>gateway-ibmi</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.logging</groupId>
      <artifactId>helidon-logging-common</artifactId>
    </dependency>

    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>gateway-runtime</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- Test scope only: the tests of the ibmi backend through the server need JTOpen, which is never packaged. -->
    <dependency>
      <groupId>net.sf.jt400</groupId>
      <artifactId>jt400</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test scope only: the fixtures are built into bundles with the modules of slay400-core. -->
    <dependency>
      <groupId>ai.generativearchitects.slay400</groupId>
      <artifactId>pcml-tasks</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The distribution, target/dist: bin/ (the launcher), lib/ (this jar and its libraries), lib/ibmi/ (the ibmi
           backend), lib/ext/ (empty: for the JTOpen the operator supplies), LICENSE, notices, bom.json, VERSION. -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${project.build.directory}/dist/lib</outputDirectory>
          <finalName>gateway</finalName>
          <archive>
            <manifest>
              <mainClass>ai.generativearchitects.slay400.gateway.server.Main</mainClass>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <excludeArtifactIds>gateway-ibmi</excludeArtifactIds>
            </configuration>
          </execution>
          <!-- The ibmi backend in a folder of its own, so that it is loaded together with JTOpen. -->
          <execution>
            <id>copy-ibmi-backend</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.generativearchitects.slay400</groupId>
                  <artifactId>gateway-ibmi</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/dist/lib/ibmi</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Every library of the distribution with its version and licence, from the dependency list: target/dist/bom.json (CycloneDX). -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>dist-bom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
            <configuration>
              <projectType>application</projectType>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
              <outputDirectory>${project.build.directory}/dist</outputDirectory>
              <includeCompileScope>true</includeCompileScope>
              <includeRuntimeScope>true</includeRuntimeScope>
              <includeProvidedScope>false</includeProvidedScope>
              <includeSystemScope>false</includeSystemScope>
              <includeTestScope>false</includeTestScope>
              <skipNotDeployed>false</skipNotDeployed>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The notices, VERSION and lib/ext/README (filtered), the launcher (not filtered) and the licence of the gateway. -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>dist-notices</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dist</outputDirectory>
              <resources>
                <resource>
                  <directory>src/dist</directory>
                  <filtering>true</filtering>
                </resource>
                <resource>
                  <directory>src/launcher</directory>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${project.basedir}/..</directory>
                  <includes>
                    <include>LICENSE</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The distribution archives, target/slay400-gateway-<version>.tar.gz and .zip, from target/dist. -->
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>distribution</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/distribution.xml</descriptor>
              </descriptors>
              <finalName>slay400-gateway-${project.version}</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The gateway over HTTP against a real IBM i (kickoff 03), started by the owner through the ibmi workflow. See gateway-ibmi. -->
    <profile>
      <id>ibmi</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
